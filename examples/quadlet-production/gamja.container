[Unit]
Description=Gamja web IRC client for production deployment
After=soju.service
Requires=soju.service

[Container]
Image=ghcr.io/ploos-as/gamja:latest
ContainerName=gamja
Network=irc.network
EnvironmentFile=/etc/gamja/gamja.env
Environment=SOJU_HOST=soju
Environment=SOJU_PORT=8080
Environment=GAMJA_SERVER_URL=/socket
ReadOnly=true
Tmpfs=/tmp
HealthCmd=wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s

[Service]
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do podman healthcheck run soju >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1'
Restart=on-failure

[Install]
WantedBy=multi-user.target
